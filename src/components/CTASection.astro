---
import { Image } from 'astro:assets';
import '../styles/CTASection.css';
---

<section class="cta reveal-on-scroll">
  <div class="container cta__container">
    <div class="cta__content">
      <h2 class="cta__title">Book a Factory Tour</h2>
      <p class="cta__text">
        What goes on behind the doors, inside our production facility? Book a tour with us to understand our capabilities and ascertain our quality standards.
      </p>
      <a href="/contact" class="cta__btn">Book Visit</a>
    </div>
    
    <div class="cta__visual">
      <div class="cta__image-container">
        <Image
          src="/images/cta_image.webp"
          alt="Production Facility"
          class="cta__image"
          width={800}
          height={600}
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>