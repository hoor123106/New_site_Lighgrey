---
import { Image } from 'astro:assets';
import aboutImg from '../assets/images/about.webp';
import '../styles/AboutUs.css';
---

<section class="about reveal-on-scroll">
  <div class="container about__container">
    <div class="about__visual">
      <div class="about__image-container">
        <Image
          src={aboutImg}
          alt="Industrial Steel Manufacturing"
          class="about__image"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
    
    <div class="about__content">
      <h2 class="about__title">We are Steelcraft.</h2>
      
      <p class="about__description_p">
        Steelcraft is a provider of commercial kitchen equipment and industrial bakery equipment with over 16 years of experience in design, sourcing, project management, manufacturing, and extending technical support for restaurants, hotels, cloud kitchens, catering establishments, industrial bakeries, and other food production facilities.
      </p>
      
      <a href="/about" class="btn btn-primary about__btn">Learn More</a>
    </div>
  </div>
</section>