---
import '../styles/satisfaction/satisfaction.css';
import { Image } from 'astro:assets';
import laughLogo from '../assets/images/laughLogo.png';
import calender from '../assets/images/calender.png';
---

<section class="satisfaction">
  <div class="container satisfaction__container">
    <div class="satisfaction__item">
      <div class="satisfaction__icon">
       <Image src={laughLogo} alt="Laugh icon" width={56} height={56} loading="lazy" decoding="async" />
      </div>
      <div class="satisfaction__text">
        <h3>500+ Projects Completed</h3>
        <p>A proven track record of delivering high-quality stainless steel solutions across the UAE.</p>
      </div>
    </div>
    
    <div class="satisfaction__item">
      <div class="satisfaction__icon">
         <Image src={calender} alt="Calendar icon" width={56} height={56} loading="lazy" decoding="async" />
      </div>
      <div class="satisfaction__text">
        <h3>16+ Years Expertise</h3>
        <p>Decades of experience in designing and manufacturing premium commercial kitchen equipment.</p>
      </div>
    </div>
  </div>
</section>
