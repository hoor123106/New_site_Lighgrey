---
import { Image } from 'astro:assets';
import '../styles/Hero2Section.css';
import hero2 from '../assets/images/Hero2.webp';
---

<section class="hero2 reveal-on-scroll">
  <div class="container hero2__container">
    <div class="hero2__content">
      <h2 class="hero2__title">
        We design and develop <br />
        industrial baking <br />
        & food production lines.
      </h2>
    </div>
    
    <div class="hero2__visual">
      <div class="hero2__image-wrapper">
        <Image
          src={hero2}
          alt="Industrial Baking Line"
          class="hero2__image"
          widths={[400, 800, 1200]}
          sizes="(max-width: 800px) 100vw, 800px"
          format="webp"
          quality="high"
        />
      </div>
    </div>
    
    <div class="hero2__spacer"></div>
  </div>
</section>