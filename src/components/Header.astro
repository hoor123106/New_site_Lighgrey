<script>
  function setupHeader() {
    const header = document.querySelector('.header');
    if (!header) return;

    const hamburger = header.querySelector('.hamburger');
    const closeBtn = header.querySelector('.menu-toggle-close');
    const mobileOverlay = header.querySelector('.nav-mobile-overlay');
    const mainMenus = header.querySelectorAll('.main-menu');
    const subMenus = header.querySelectorAll('.submenu');
    
    function toggleMobileMenu(force) {
      const isOpen = force !== undefined ? force : !mobileOverlay?.classList.contains('is-open');
      mobileOverlay?.classList.toggle('is-open', isOpen);
      document.body.style.overflow = isOpen ? 'hidden' : '';
      header?.classList.toggle('menu-active', isOpen);
      
      if (!isOpen) {
        subMenus.forEach(sm => sm.classList.remove('active'));
        mainMenus.forEach(mm => mm.classList.add('active'));
      }
    }

    hamburger?.addEventListener('click', () => toggleMobileMenu(true));
    closeBtn?.addEventListener('click', () => toggleMobileMenu(false));

    header.querySelectorAll('.nav-link--trigger').forEach(trigger => {
      trigger.addEventListener('click', () => {
        const label = trigger.getAttribute('data-submenu');
        const target = header.querySelector(`#submenu-${label}`);
        if (target) {
          mainMenus.forEach(mm => mm.classList.remove('active'));
          target.classList.add('active');
        }
      });
    });

    header.querySelectorAll('.back-button').forEach(btn => {
      btn.addEventListener('click', () => {
        subMenus.forEach(sm => sm.classList.remove('active'));
        mainMenus.forEach(mm => mm.classList.add('active'));
      });
    });

    header.querySelectorAll('.nav-mobile-overlay a').forEach(link => {
      link.addEventListener('click', () => toggleMobileMenu(false));
    });
  }

  setupHeader();
  document.addEventListener('astro:after-swap', setupHeader);
</script>
