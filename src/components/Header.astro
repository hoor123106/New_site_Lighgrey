---
import '../styles/header.css';
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.png';
import email from '../assets/images/email.png';

const currentPath = Astro.url.pathname;

const navItems = [
  { 
    label: 'Industries', 
    subItems: [
      { label: 'Commercial Kitchens', href: '/industries/commercial-kitchens' },
      { label: 'Industrial Bakeries', href: '/industries/industrial-bakeries' }
    ]
  },
  { label: 'Services', href: '/services' },
  { label: 'Projects', href: '/blog' },
  { label: 'About Us', href: '/about' },
  { label: 'Get In Touch', href: '/contact' }
];

const isActive = (href) => {
  if (href === '/' || href === '#') return currentPath === '/' ;
  return currentPath === href || currentPath.startsWith(`${href}/`);
};
---

<header class="header" transition:persist>
  <nav class="navbar" aria-label="Primary navigation">
    <div class="mobile-left-action">
      <button class="menu-toggle-close" type="button" aria-expanded="false" aria-controls="header-nav-mobile" aria-label="Close menu">
        <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>

    <a href="/" class="logo header-enter header-enter--logo" aria-label="Steelcraft home">
      <Image src={logo} alt="Steelcraft"/>
    </a>

    <ul class="nav-list nav-list--desktop nav-list--center header-enter header-enter--nav">
      {
        navItems.map((item) => (
          <li class={item.subItems ? 'has-dropdown' : ''}>
            <a href={item.href} class={`nav-link ${isActive(item.href) ? 'is-active' : ''}`.trim()}>
              {item.label}
              {item.subItems && (
                <svg class="dropdown-arrow" viewBox="0 0 20 20" width="12" height="12" fill="currentColor"><path d="M5.2 7.6L10 12.4l4.8-4.8 1.2 1.2-6 6-6-6 1.2-1.2z"/></svg>
              )}
            </a>
            {item.subItems && (
              <ul class="dropdown-menu">
                {item.subItems.map(subItem => (
                  <li><a href={subItem.href}>{subItem.label}</a></li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>

    <div class="header-actions header-enter header-enter--actions">
