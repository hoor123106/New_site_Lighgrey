---
import { Image } from 'astro:assets';
import '../styles/header/header.css';
import logo from '../assets/images/logo.webp';

const currentPath = Astro.url.pathname;

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'PRODUCTS', href: '/products', hasChevron: true },
  { label: 'ABOUT US', href: '/about', hasChevron: true },
  { label: 'CONTACT US', href: '/contact', hasChevron: true }
];

const isActive = (href) => {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(`${href}/`);
};
---

<header class="header" transition:persist>
  <nav class="navbar">
    <div class="menu-trigger" id="menuToggle">
      <span class="menu-label">MENU</span>
      <div class="hamburger">
        <span></span>
        <span></span>
        <span></span>
      </div>
    </div>

    <div class="logo-center">
      <a href="/" aria-label="Home">
        <Image src={logo} alt="Steelcraft" width={350} height={177} loading="eager" />
      </a>
    </div>

    <div class="header-right-spacer"></div>
  </nav>

  <div class="side-menu-overlay" id="sideMenuOverlay">
    <div class="side-menu">
      <div class="side-menu-header">
        <button class="close-menu" id="closeMenu" aria-label="Close menu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="32" height="32"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>
      
      <ul class="side-menu-list">
        {navItems.map((item) => (
          <li class={`nav-item ${item.label === 'Home' ? 'home-link' : ''}`}>
            <a href={item.href} class={isActive(item.href) ? 'is-active' : ''}>
              {item.label}
              {item.hasChevron && (
                <svg class="chevron-right" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</header>

<script>
  function setupHeader() {
    const menuToggle = document.getElementById('menuToggle');
    const closeMenu = document.getElementById('closeMenu');
    const sideMenuOverlay = document.getElementById('sideMenuOverlay');

    if (!menuToggle || !sideMenuOverlay) return;

    const openMenu = () => {
      sideMenuOverlay.classList.add('is-active');
      document.body.style.overflow = 'hidden';
    };

    const close = () => {
      sideMenuOverlay.classList.remove('is-active');
      document.body.style.overflow = '';
    };

    menuToggle.addEventListener('click', openMenu);
    closeMenu?.addEventListener('click', close);
    sideMenuOverlay.addEventListener('click', (e) => {
      if (e.target === sideMenuOverlay) close();
    });

    sideMenuOverlay.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', close);
    });
  }

  setupHeader();
  document.addEventListener('astro:after-swap', setupHeader);
</script>