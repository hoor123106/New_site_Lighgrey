---
import { Image } from 'astro:assets';
import '../styles/testimonial/testimonial.css';

import t1 from '../assets/images/testimonial1.png';
import t2 from '../assets/images/testimonial2.png';
import t3 from '../assets/images/testimonial3.png';

const testimonials = [
  {
    img: t1,
    name: "Hassan Al-Mansoori",
    location: "Dubai, UAE",
    text: "“Steelcraft provided the complete stainless steel fit-out for our new restaurant. The quality of the welding and the precision of the measurements exceeded our expectations. Truly professional craftsmanship.”"
  },
  {
    img: t2,
    name: "Sarah Ibrahim",
    location: "Abu Dhabi, UAE",
    text: "“We've been working with Steelcraft for over 5 years. Their maintenance support and genuine spare parts availability have been crucial for our high-volume bakery production. They understand the local market needs perfectly.”"
  },
  {
    img: t3,
    name: "James Wilson",
    location: "Sharjah, UAE",
    text: "“From the initial design stage to the final installation, the team at Steelcraft was fantastic. Their custom fabrication solutions saved us significant space in our cloud kitchen. Highly recommended for any F&B operator.”"
  }
];
---

<section class="testimonials">
  <div class="container testimonials__container">
    <div class="testimonials__header">
      <span class="testimonials__label">Success Stories</span>
      <h2 class="testimonials__title">Trusted by Hospitality Leaders</h2>
    </div>
    
    <div class="testimonials__grid">
      {testimonials.map((item) => (
        <div class="testimonial-card">
          <div class="testimonial-card__content">
            <p class="testimonial-card__text">{item.text}</p>
          <div class="testimonial-card__author">
            <Image
              src={item.img}
              alt={item.name}
              class="testimonial-card__avatar"
              width={64}
              height={64}
              loading="lazy"
              decoding="async"
            />
            <div class="testimonial-card__meta">
              <h3 class="testimonial-card__name">{item.name}</h3>
              <p class="testimonial-card__location">{item.location}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>