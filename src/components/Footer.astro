---
import '../styles/footer/footer.css';
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.webp';

const currentPath = Astro.url.pathname;
const navItems = [
  { href: '/about', label: 'ABOUT US' },
  { href: '/contact', label: 'CONTACT US' },
  { href: '/', label: 'HOME' },
  { href: '/products', label: 'PRODUCTS' }
];

const quickLinks = [
  { href: '#', label: 'Terms and Conditions' },
  { href: '#', label: 'Privacy Policy' },
  { href: '#', label: 'Disclaimer' }
];
---

<footer class="footer">
  <div class="container footer-container">
    <div class="footer-top">
      <!-- Left Column: Logo & Description -->
      <div class="footer-col footer-info">
        <a href="/" class="footer-logo" aria-label="Steelcraft home">
          <Image src={logo} alt="Steelcraft" width={200} height={60} />
        </a>
        <p class="footer-description">
          <strong>Steelcraft</strong> is simply dummy text of the printing and typesetting industry. Steelcraft has been the industry's standard dummy text ever since the 1500s.
        </p>
      </div>

      <!-- Middle Column: Navigation -->
      <div class="footer-col footer-nav">
        <ul class="footer-links">
          {navItems.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Right Column: Quick Links -->
      <div class="footer-col footer-quick">
        <h4 class="footer-col-title">Quick Links</h4>
        <ul class="quick-links-list">
          {quickLinks.map((item) => (
            <li>
              <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="footer-divider"></div>
      <div class="footer-bottom-content">
        <div class="footer-socials">
          <a href="#" aria-label="Facebook">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
          </a>
          <a href="#" aria-label="Twitter">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path></svg>
          </a>
          <a href="#" aria-label="Instagram">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          </a>
          <a href="#" aria-label="WhatsApp">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 1 1-7.6-7.6 8.38 8.38 0 0 1 3.8.9L21 3z"></path></svg>
          </a>
          <a href="#" aria-label="LinkedIn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
          </a>
        </div>
        <p class="copyright">
          Copyright © 2026 - Steelcraft | All Rights Reserved
        </p>
      </div>
    </div>
  </div>
</footer>
