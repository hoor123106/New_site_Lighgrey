---
import { Image } from 'astro:assets';
import '../styles/LastSection.css';
import homeLastImage from '../assets/images/home_last_image.png';
---

<section class="last-section reveal-on-scroll">
  <div class="last-section__image-container">
    <Image
      src={homeLastImage}
      alt="Steelcraft Excellence"
      class="last-section__image"
      width={1200}
      height={400}
      loading="lazy"
      decoding="async"
    />
  </div>
</section>
