---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import '../../styles/products-index.css';

const products = await getCollection('products');
const sortedProducts = products.sort((a, b) => a.data.title.localeCompare(b.data.title));

// Image resolution logic
const allImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/**/*.{jpeg,jpg,png,gif,webp}');
---

<Layout title="Our Products | Steelcraft" description="Explore our high-quality stainless steel commercial kitchen and industrial bakery products.">
  <main class="products-index-page">
    <div class="container pb-40">
      <h1 class="page-title reveal-on-scroll">Our Products</h1>
      <p class="page-subtitle reveal-on-scroll">Precision-engineered stainless steel solutions</p>

      <div class="products-grid">
        {sortedProducts.map((product) => {
          const imagePath = product.data.image?.replace('../../assets', '/src/assets');
          const filename = imagePath?.split('/').pop();
          const imageKey = Object.keys(allImages).find(
            (key) => key === imagePath || key.endsWith(`/${filename}`)
          );
          const imageSrc = imageKey ? allImages[imageKey] : null;

          return (
            <article class="product-card reveal-on-scroll">
              <a href={`/products/${product.id.replace(/\.(md|mdx)$/, '')}`} class="product-card-link">
                <div class="product-image-wrapper">
                  {imageSrc ? (
                    <Image 
                      src={imageSrc()} 
                      alt={product.data.imageAlt || product.data.title}
                      width={600}
                      height={600}
                      class="product-img"
                    />
                  ) : (
                    <div class="product-placeholder">No Image Available</div>
                  )}
                </div>
                <div class="product-info">
                  {product.data.category && <span class="product-category">{product.data.category}</span>}
                  <h2 class="product-title">{product.data.title}</h2>
                  {product.data.description && <p class="product-description">{product.data.description}</p>}
                  <span class="view-details">View Details</span>
                </div>
              </a>
            </article>
          );
        })}
      </div>
    </div>
  </main>
</Layout>

<script>
  function setupReveal() {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('reveal-visible');
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('.reveal-on-scroll').forEach(el => observer.observe(el));
  }
  setupReveal();
  document.addEventListener('astro:after-swap', setupReveal);
</script>
