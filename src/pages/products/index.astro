---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import FeatureSection from '../../components/FeatureSection.astro';
import HeroSection from '../../components/HeroSection.astro';
import Testimonial from '../../components/Testimonial.astro';
import '../../styles/products/index.css';

// Image imports
import feature1 from '../../assets/images/Prodcut-Making-In-home.png';
import feature2 from '../../assets/images/about.webp';
import heroLast from '../../assets/images/Home_bg.webp';

const products = await getCollection('products');
// No longer sorting or using products since we are removing the grid
---

<Layout title="Our Products | Steelcraft" description="Explore our high-quality stainless steel commercial kitchen and industrial bakery products." fullWidth={true}>
  <main class="products-index-page">

      <!-- Top Hero Section -->
    <HeroSection 
      title="The Founders"
      description="These ten values are derived from the quest for perfection that was established ever since 1839 through the legacy of our founders."
      buttonText="Buy This Now!"
      bgImage={heroLast}
      align="center"
      height="medium"
      overlayOpacity={0.6}
    />

    <section class="section-intro container">
      <h2 class="intro-title">Our Values</h2>
      <p class="intro-description">
        Our ten core values reflect the "Patek Philippe spirit", a culture that our company has upheld faithfully and passionately since 1839.
      </p>
    </section>

  <FeatureSection 
    title="Independence"
    buttonText="Learn More"
    description="Assembling one of the world’s most extraordinary watch collections, our Museum showcases our legacy and represents an inexhaustible source of inspiration for our designers and artists.."
    image={feature1}
  />

  <FeatureSection 
    title="Excellence"
    buttonText="Buy This Now!"
    description="Assembling one of the world’s most extraordinary watch collections, our Museum showcases our legacy and represents an inexhaustible source of inspiration for our designers and artists.."
    image={feature2}
    reverse={true}
  />
  <FeatureSection 
    title="Independence"
    buttonText="Learn More"
    description="Assembling one of the world’s most extraordinary watch collections, our Museum showcases our legacy and represents an inexhaustible source of inspiration for our designers and artists.."
    image={feature1}
  />

  <FeatureSection 
    title="Excellence"
    buttonText="Buy This Now!"
    description="Assembling one of the world’s most extraordinary watch collections, our Museum showcases our legacy and represents an inexhaustible source of inspiration for our designers and artists.."
    image={feature2}
    reverse={true}
  />

  <Testimonial 
    quote="We love Gutenberg! Our designers were using it for their projects, so clients already knew what Gutenberg was and how to use it."
    author="Jane"
    role="Founder"
    companyName="Company"
    />
  <FeatureSection 
    title="Independence"
    buttonText="Learn More"
    description="Assembling one of the world’s most extraordinary watch collections, our Museum showcases our legacy and represents an inexhaustible source of inspiration for our designers and artists.."
    image={feature1}
  />

  <FeatureSection 
    title="Excellence"
    buttonText="Buy This Now!"
    description="Assembling one of the world’s most extraordinary watch collections, our Museum showcases our legacy and represents an inexhaustible source of inspiration for our designers and artists.."
    image={feature2}
    reverse={true}
  />
      <!-- Bottom Hero Section -->
    <HeroSection 
      title="The Founders"
      description="These ten values are derived from the quest for perfection that was established ever since 1839 through the legacy of our founders."
      buttonText="Buy This Now!"
      bgImage={heroLast}
      align="center"
      height="medium"
      overlayOpacity={0.6}
    />

  </main>
</Layout>
