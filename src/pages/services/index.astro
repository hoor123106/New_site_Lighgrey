---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import '../../styles/services-index.css';

// Import service images
import designImg from '../../assets/images/services/design.webp';
import manufacturingImg from '../../assets/images/services/manufacturing.webp';
import projectManagementImg from '../../assets/images/services/project_management.webp';
import sourcingImg from '../../assets/images/services/sourcing.webp';
import technicalSupportImg from '../../assets/images/services/technical_support.webp';

const services = await getCollection('services');
const sortedServices = services.sort((a, b) => a.data.title.localeCompare(b.data.title));

// Category images mapping
const categoryImages = {
  'design': designImg,
  'manufacturing': manufacturingImg,
  'project-management': projectManagementImg,
  'sourcing': sourcingImg,
  'technical-support': technicalSupportImg,
};
---

<Layout
  title="Our Services | Steelcraft"
  description="Explore the wide range of professional services offered by Steelcraft."
  fullWidth={true}
>
  <div class="services-index-page">
    <section class="intro-section reveal-on-scroll">
      <div class="index-container">
        <h1 class="index-main-title">Our Services</h1>
      </div>
    </section>

    <section class="deal-in-section reveal-on-scroll">
      <div class="index-container">
        <h2>WE SPECIALIZE IN</h2>
      </div>
    </section>

    <section class="categories-grid-section">
      <div class="index-container">
        <div class="services-grid">
          {sortedServices.map((service, index) => {
            const currentSlug = service.id.replace(/\.(md|mdx)$/, '');
            const categoryImg = categoryImages[currentSlug] || "/images/placeholder.webp";
            
            return (
              <a 
                href={`/services/${currentSlug}`} 
                class="service-card reveal-on-scroll"
                style={`transition-delay: ${index * 0.1}s;`}
              >
                <div class="card-image">
                  {typeof categoryImg === 'string' ? (
                    <img 
                      src={categoryImg} 
                      alt={service.data.title} 
                      style="width: 100%; height: auto; object-fit: cover; aspect-ratio: 16/9;"
                    />
                  ) : (
                    <Image 
                      src={categoryImg} 
                      alt={service.data.title} 
                      widths={[300, 600]}
                      sizes="(max-width: 640px) 100vw, 300px"
                      format="webp"
                      quality="mid"
                    />
                  )}
                </div>
                <h3>{service.data.title}</h3>
                {service.data.metaDescription && <p>{service.data.metaDescription}</p>}
                <span class="card-link-text">Explore Service</span>
              </a>
            );
          })}
        </div>

        <div class="index-cta-wrap reveal-on-scroll">
            <a href="/get-in-touch" class="index-cta-btn">Get in touch</a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  function setupReveal() {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('reveal-visible');
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('.reveal-on-scroll').forEach(el => {
      observer.observe(el);
    });
  }
  setupReveal();
  document.addEventListener('astro:after-swap', setupReveal);
</script>