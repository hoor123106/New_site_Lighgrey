---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import '../../styles/services/index.css';

const services = await getCollection('services');
const sortedServices = services.sort((a, b) => a.data.title.localeCompare(b.data.title));

const CLOUDINARY_BASE = "https://res.cloudinary.com/creyo-com/image/upload/v1776843293/steelcraft/services/";
const FALLBACK_IMAGE = `${CLOUDINARY_BASE}service-placeholder.avif`;

---

<Layout
  title="Our Services | Steelcraft"
  description="Explore the wide range of professional services offered by Steelcraft."
  fullWidth={true}
>
  <div class="services-index-page">
    <section class="intro-section reveal-on-scroll">
      <div class="index-container">
        <h1 class="index-main-title">Our Services</h1>
      </div>
    </section>

    <section class="deal-in-section reveal-on-scroll">
      <div class="index-container">
        <h2>WE SPECIALIZE IN</h2>
      </div>
    </section>

    <section class="categories-grid-section">
      <div class="index-container">
        <div class="services-grid">
          {sortedServices.map((service, index) => {
            const currentSlug = service.id.replace(/\.(md|mdx)$/, '');
            const d = service.data;
            const imgUrl = d.image ? `${CLOUDINARY_BASE}${d.image}` : `${CLOUDINARY_BASE}${currentSlug}.avif`;
            
            return (
              <a 
                href={`/services/${currentSlug}`} 
                class="service-card reveal-on-scroll"
                style={`transition-delay: ${index * 0.1}s;`}
              >
                <div class="card-image">
                  <img 
                    src={imgUrl} 
                    alt={d.imageAlt || d.title} 
                    class="service-card-img"
                    loading="lazy"
                    onerror={`this.onerror=null;this.src='${FALLBACK_IMAGE}';`}
                  />
                </div>
                <h3>{d.title}</h3>
                {d.metaDescription && <p>{d.metaDescription}</p>}
                <span class="card-link-text">Explore Service</span>
              </a>
            );
          })}
        </div>

        <div class="index-cta-wrap reveal-on-scroll">
            <a href="/get-in-touch" class="index-cta-btn">Get in touch</a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  function setupReveal() {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('reveal-visible');
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('.reveal-on-scroll').forEach(el => {
      observer.observe(el);
    });
  }
  setupReveal();
  document.addEventListener('astro:after-swap', setupReveal);
</script>