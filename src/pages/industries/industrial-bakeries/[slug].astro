---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import '../../../styles/industrial-bakeries/slug.css';

export async function getStaticPaths() {
  const bakeries = await getCollection('industrialBakeries');
  return bakeries.map((bakery) => ({
    params: { slug: bakery.id.split('/').pop().replace(/\.(md|mdx)$/, '') },
  }));
}

const { slug } = Astro.params;
const bakeries = await getCollection('industrialBakeries');
const bakeryItems = bakeries.find(
  (b) => b.id.split('/').pop().replace(/\.(md|mdx)$/, '') === slug
);

if (!bakeryItems) {
  throw new Error(`Bakery not found for slug: ${slug}`);
}

const { Content } = await render(bakeryItems);
const d = bakeryItems.data;

const CLOUDINARY_BASE = "https://res.cloudinary.com/creyo-com/image/upload/v1776843293/steelcraft/industrial-bakeries/";
const FALLBACK_IMAGE = `${CLOUDINARY_BASE}industrial-bakeries-placeholder.avif`;

const sections = [];
for (let i = 1; i <= 20; i++) {
  const title = d[`section${i}Title` as keyof typeof d];
  const desc = d[`section${i}Description` as keyof typeof d];
  const imgName = d[`section${i}Image` as keyof typeof d] as string | undefined;
  const alt = d[`section${i}Alt` as keyof typeof d];
  
  if (title || desc || imgName) {
    const imgUrl = imgName ? `${CLOUDINARY_BASE}${imgName}` : FALLBACK_IMAGE;
    sections.push({ img: imgUrl, alt, title, desc });
  } else if (i > 3) break;
}


const ctas = [];
for (let i = 1; i <= 20; i++) {
  const icon = d[`cta${i}Icon` as keyof typeof d];
  const title = d[`cta${i}Title` as keyof typeof d];
  const desc = d[`cta${i}Description` as keyof typeof d];
  if (title || desc || icon) {
    ctas.push({ icon, title, desc });
  } else if (i > 3) break;
}

function parseMarkdown(text: string) {
  if (!text) return '';
  
  // Handle bold text **text**
  let html = text.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
  
  // Split into lines for list handling
  const lines = html.split('\n');
  let result = [];
  let inList = false;
  
  for (let line of lines) {
    const trimmed = line.trim();
    if (trimmed.startsWith('- ')) {
      if (!inList) {
        result.push('<ul class="section-list">');
        inList = true;
      }
      result.push(`<li>${trimmed.substring(2)}</li>`);
    } else if (trimmed === '') {
      if (inList) {
        result.push('</ul>');
        inList = false;
      }
    } else {
      if (inList) {
        result.push('</ul>');
        inList = false;
      }
      result.push(`<p>${trimmed}</p>`);
    }
  }
  
  if (inList) result.push('</ul>');
  
  return result.join('');
}
---

<Layout
  title={d.metaTitle || d.title}
  description={d.metaDescription || d.description}
  fullWidth={true}
>
  <div class="bakery-page">

    <section class="bakery-hero">
     <div class="back-wrap container reveal-on-scroll">
      <a href="/industries/industrial-bakeries" class="back-link">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Back to Industrial Bakeries
      </a>
    </div>
      <div class="bakery-hero__inner reveal-on-scroll">
        <h1 set:html={d.heroTitle || d.title} />
        {d.heroSubtitle && <p class="bakery-hero__subtitle" set:html={d.heroSubtitle} />}
        {d.description && <p class="bakery-hero__main-description" set:html={d.description} />}
      </div>
    </section>

    {sections.length > 0 && (
      <section class="bakery-features">
        {sections.map((section, index) => (
          <div class="feature-row reveal-on-scroll">
            <div class="feature-image-col">
              <div class="feature-image-wrapper">
                   <img 
                    src={section.img} 
                    alt={section.alt || section.title || "Bakery Section"} 
                    class="feature-image"
                    loading="lazy"
                    onerror={`this.onerror=null;this.src='${FALLBACK_IMAGE}';`}
                  />
              </div>
            </div>
            <div class="feature-content-col">
              <h2 set:html={section.title} />
              <div class="section-desc" set:html={parseMarkdown(section.desc)} />
            </div>
          </div>
        ))}
      </section>
    )}

    {(d.ourProcessTitle || d.ourProcessDescription) && (
      <section class="bakery-process">
        <div class="bakery-process__container reveal-on-scroll">
          {d.ourProcessSubtitle && <span class="process-subtitle" set:html={d.ourProcessSubtitle} />}
          <h2 set:html={d.ourProcessTitle} />
          {d.ourProcessDescription && <p class="process-description" set:html={d.ourProcessDescription} />}
        </div>
      </section>
    )}

    {ctas.length > 0 && (
      <section class="bakery-ctas">
        <div class="bakery-ctas__grid">
          {ctas.map((cta, index) => (
            <div class="cta-item reveal-on-scroll" style={`transition-delay: ${index * 0.1}s;`}>
              <div class="cta-icon">
                {cta.icon ? (
                  <span set:html={cta.icon} />
                ) : (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                )}
              </div>
              <div class="cta-text">
                <h3 set:html={cta.title} />
                <p set:html={cta.desc} />
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <section class="mdx-body reveal-on-scroll">
      <div class="mdx-body__inner">
        <Content />
      </div>
    </section>

    {d.footNote && (
      <section class="bakery-footer-note reveal-on-scroll">
        <div class="footer-note-content" set:html={d.footNote} />
      </section>
    )}
    
  </div>
</Layout>

<script>
  function setupReveal() {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('reveal-visible');
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('.reveal-on-scroll').forEach(el => {
      observer.observe(el);
    });
  }

  setupReveal();
  document.addEventListener('astro:after-swap', setupReveal);
</script>
