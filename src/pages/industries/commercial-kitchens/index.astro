---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import '../../../styles/commercial-kitchens/index.css';

// Import intro images
import intro1 from '../../../assets/images/commercial-kitchens/commercial-kitches_image_1.webp';
import intro2 from '../../../assets/images/commercial-kitchens/commercial-steelness_image_2.webp';


const kitchens = await getCollection('commercialKitchens', ({ data }) => {
  return data.publish !== 'n'; // Publish if not explicitly 'n'
});
const sortedKitchens = kitchens.sort((a, b) => (a.data.order || 999) - (b.data.order || 999));

const CLOUDINARY_BASE = "https://res.cloudinary.com/creyo-com/image/upload/v1776843293/steelcraft/commercial-kitchens/";
const FALLBACK_IMAGE = `${CLOUDINARY_BASE}front-of-house.avif`;

---

<Layout
  title="Commercial Kitchens | Steelcraft"
  description="Steelcraft provides an extensive range of high-quality commercial kitchen equipment and services."
  fullWidth={true}
>
  <div class="kitchen-index-page">
    <section class="intro-section reveal-on-scroll">
      <div class="index-container">
        <h1 class="index-main-title">Commercial Kitchens</h1>
        
        <!-- Row 1 -->
        <div class="intro-row">
          <div class="intro-image-col">
            <div class="intro-image-wrapper">
              <Image 
                src={intro1} 
                alt="Commercial Kitchen Workflow" 
                widths={[400, 800, 1200]}
                sizes="(max-width: 800px) 100vw, 800px"
                format="webp"
                quality="high"
                class="intro-img"
              />
            </div>
          </div>
          <div class="intro-content-col">
            <p>
              Steelcraft provides an extensive range of high-quality commercial kitchen equipment and services, 
              and we are committed to meeting the unique needs of the food service industry. Our commercial 
              kitchen equipment line provides a comprehensive range of top-notch products designed to enhance 
              the efficiency and productivity of commercial kitchens. From cooking appliances and refrigeration 
              systems to food preparation equipment and dishwashing solutions, we have everything you need to 
              equip your kitchen for success. 
            </p>
            <p>
              We carefully source our equipment from trusted manufacturers known for their reliability, durability, 
              and advanced features, ensuring our clients receive the best-in-class products. We understand that 
              every commercial kitchen has specific requirements and challenges. 
            </p>
            <p>
              Our team of experienced professionals provides personalized consultation and customization services. 
              We work closely with our clients to understand their unique needs and goals, offering tailored 
              solutions that optimize workflows and maximize operational efficiency. Our experts ensure your 
              kitchen is ready for peak performance.
            </p>
          </div>
        </div>

        <div class="intro-row">
          <div class="intro-image-col">
            <div class="intro-image-wrapper">
              <Image 
                src={intro2} 
                alt="Stainless Steel Fabrication" 
                widths={[400, 800, 1200]}
                sizes="(max-width: 800px) 100vw, 800px"
                format="webp"
                quality="high"
                class="intro-img"
              />
            </div>
          </div>
          <div class="intro-content-col">
            <div class="content-group">
                <h2>Customized Stainless Steel Fabrication</h2>
                <p>
                  In addition to our comprehensive product line, we specialize in providing customized stainless 
                  steel equipment for commercial kitchens. Our team of fabricators produces high-quality, 
                  tailor-made equipment that perfectly fits customers' unique kitchen spaces and requirements.
                </p>
                <p>
                  Using Grade 304 stainless steel (or Grade 316, where recommended), we ensure that our 
                  customized equipment meets the highest standards of durability and hygiene and enhances the 
                  kitchen's overall aesthetics. From custom stainless steel countertops and workstations to 
                  shelves, cabinets, and storage solutions, we have the expertise to create functional and 
                  visually appealing equipment that optimizes workflow.
                </p>
            </div>
            
            <div class="content-group">
                <h2>Customer Satisfaction</h2>
                <p>
                  At Steelcraft, we prioritize customer satisfaction and long-term partnerships. That's why a 
                  team of skilled technicians and service professionals backs our commercial kitchen equipment 
                  division. We provide prompt and reliable technical support, ensuring your equipment operates 
                  at its best. 
                </p>
                <p>
                  From installation and maintenance to repairs and troubleshooting, our dedicated team is 
                  always ready to assist you. We understand the critical role of uptime in your kitchen 
                  operations, and we strive to minimize disruptions to keep your business running smoothly.
                </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="deal-in-section reveal-on-scroll">
      <div class="index-container">
        <h2>WE DEAL IN</h2>
      </div>
    </section>

    <section class="categories-grid-section">
      <div class="index-container">
        <div class="kitchens-grid">
          {sortedKitchens.map((kitchen, index) => {
            const imageName = kitchen.data.image;
            const categoryImg = imageName ? `${CLOUDINARY_BASE}${imageName}` : FALLBACK_IMAGE;
            
            return (
              <a 
                href={`/industries/commercial-kitchens/${kitchen.id.split('/').pop().replace(/\.(md|mdx)$/, '')}`} 
                class="kitchen-card reveal-on-scroll"
                style={`transition-delay: ${index * 0.1}s;`}
              >
                <div class="card-image">
                   <img 
                      src={categoryImg} 
                      alt={kitchen.data.imageAlt || kitchen.data.title} 
                      style="width: 100%; height: auto; object-fit: cover; aspect-ratio: 16/9;"
                      loading="lazy"
                      onerror={`this.onerror=null;this.src='${FALLBACK_IMAGE}';`}
                    />
                </div>
                <h3>{kitchen.data.title}</h3>
                {kitchen.data.metaDescription && <p>{kitchen.data.metaDescription}</p>}
                <span class="card-link-text">Read More</span>
              </a>
            );
          })}
        </div>

        <div class="index-cta-wrap reveal-on-scroll">
            <a href="/get-in-touch" class="index-cta-btn">Get in touch</a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  function setupReveal() {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('reveal-visible');
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('.reveal-on-scroll').forEach(el => {
      observer.observe(el);
    });
  }
  setupReveal();
  document.addEventListener('astro:after-swap', setupReveal);
</script>