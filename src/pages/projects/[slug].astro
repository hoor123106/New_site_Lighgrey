---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import '../../styles/project/slug.css';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id.replace(/\.(md|mdx)$/, '') },
  }));
}

const { slug } = Astro.params;
const projects = await getCollection('projects');
const project = projects.find(
  (p) => p.id.replace(/\.(md|mdx)$/, '') === slug
);

if (!project) {
  throw new Error(`Project not found for slug: ${slug}`);
}

const { Content } = await render(project);
const d = project.data;

const CLOUDINARY_BASE = "https://res.cloudinary.com/creyo-com/image/upload/v1776843293/steelcraft/commercial-kitchens/";
const FALLBACK_IMAGE = `${CLOUDINARY_BASE}commercial-kitchen-placeholder.avif`;

const getUrl = (img) => {
  if (!img) return FALLBACK_IMAGE;
  if (typeof img === 'string') return img.startsWith('http') ? img : `${CLOUDINARY_BASE}${img}`;
  return img;
};

const mainImgUrl = getUrl(d.image);

const getFeatureImgUrl = (img) => {
  if (!img) return null;
  return typeof img === 'string' ? (img.startsWith('http') ? img : `${CLOUDINARY_BASE}${img}`) : img;
};

const featureImages = [d.feature1Image, d.feature2Image, d.feature3Image]
  .map(getFeatureImgUrl)
  .filter(img => img && (typeof img === 'string' ? img !== mainImgUrl : img?.src !== mainImgUrl?.src));
---

<Layout
  title={d.metaTitle || d.title}
  description={d.metaDescription || d.description}
  fullWidth={true}
>
  <div class="project-page">
    <section class="project-hero">
      <div class="container reveal-on-scroll">
        <a href="/projects" class="back-link">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          Back to Projects
        </a>
        <div class="hero-content">
          <span class="project-category">{d.category || d.Category}</span>
          <h1>{d.title}</h1>
          <div class="project-meta">
            <div class="meta-item">
              <span class="meta-label">Location</span>
              <span class="meta-value">{d.location || d.Location}</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="project-main">
      <div class="container">
        <div class="project-layout">
          <div class="project-details reveal-on-scroll">
            <div class="project-description">
              <h2>Project Overview</h2>
              <p>{d.description || d.Description}</p>
            </div>
            
            <div class="mdx-content">
              <Content />
            </div>
          </div>
          
            <div class="project-visuals reveal-on-scroll">
              <div class="main-image-wrapper">
                {typeof mainImgUrl === 'string' ? (
                  <img
                    src={mainImgUrl}
                    alt={d.imageAlt || d.title}
                    width="1000"
                    height="600"
                    loading="lazy"
                    class="main-project-image"
                    style="width: 100%; height: auto; object-fit: cover;"
                    onerror={`this.onerror=null;this.src='${FALLBACK_IMAGE}';`}
                  />
                ) : (
                  <Image 
                    src={mainImgUrl} 
                    alt={d.imageAlt || d.title} 
                    width={1000}
                    height={600}
                    format="webp"
                    quality="high"
                    class="main-project-image"
                  />
                )}
              </div>
              
              <div class="additional-features">
                {featureImages.map((img, i) => (
                  <div class="feature-img-wrap" key={i}>
                    {typeof img === 'string' ? (
                      <img 
                        src={img} 
                        alt={`${d.title} feature ${i+1}`} 
                        width="400" 
                        height="300" 
                        loading="lazy" 
                        style="width: 100%; height: auto; object-fit: cover;" 
                        onerror={`this.onerror=null;this.src='${FALLBACK_IMAGE}';`}
                      />
                    ) : (
                      <Image src={img} alt={`${d.title} feature ${i+1}`} width={400} height={300} format="webp" />
                    )}
                  </div>
                ))}
              </div>
            </div>
        </div>
      </div>
    </section>

    <section class="project-cta reveal-on-scroll">
      <div class="container">
        <div class="cta-box">
          <h2>Ready to transform your space?</h2>
          <p>Get in touch with our experts to discuss your industrial kitchen or bakery requirements.</p>
          <a href="/contact" class="cta-button">Contact Us Now</a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  function setupReveal() {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('reveal-visible');
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('.reveal-on-scroll').forEach(el => {
      observer.observe(el);
    });
  }
  setupReveal();
  document.addEventListener('astro:after-swap', setupReveal);
</script>
