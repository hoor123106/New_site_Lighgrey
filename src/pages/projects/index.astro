---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import '../../styles/project/index.css';

const projects = await getCollection('projects');
const sortedProjects = projects.sort((a, b) => a.data.title.localeCompare(b.data.title));

const CLOUDINARY_BASE = "https://res.cloudinary.com/creyo-com/image/upload/v1776843293/steelcraft/commercial-kitchens/";
const FALLBACK_IMAGE = `${CLOUDINARY_BASE}commercial-kitchen-placeholder.avif`;
---

<Layout
  title="Our Projects | Steelcraft"
  description="Explore the portfolio of Steelcraft's premium industrial kitchen and bakery projects across Dubai and the UAE."
  fullWidth={true}
>
  <div class="projects-index-page">
    <section class="intro-section reveal-on-scroll">
      <div class="index-container intro-grid">
        <div class="intro-left">
          <h1 class="index-main-title">Our Projects</h1>
        </div>
        <div class="intro-right">
          <p class="projects-intro-text">
            We spend much of our attention on each project and work with a few limited clients every year, supplying kitchen equipment for a wide range of restaurant kitchen projects. Over the years, we have completed projects in various countries across the GCC region, and now we have embarked on projects in the Indian subcontinent. Our approach to projects verges on the consultative, enabling our clients to view us as partners with the same goals. Our project management services include the kitchen equipment layout, MEP drawings, exhaust requirement calculations, sourcing of equipment, supply, installation & technical services, and manufacturing of stainless steel equipment. 
          </p>
          <p class="projects-secondary-text">
            Following are some of our recent projects. If you want your project to appear here, contact us today.
          </p>
        </div>
      </div>
    </section>

    <section class="projects-grid-section">
      <div class="index-container">
        <div class="projects-grid">
          {sortedProjects.map((project, index) => {
            const getUrl = (img) => {
              if (!img) return FALLBACK_IMAGE;
              if (typeof img === 'string') return img.startsWith('http') ? img : `${CLOUDINARY_BASE}${img}`;
              return img;
            };
            const imgUrl = getUrl(project.data.image);

            return (
              <div 
                class="project-card reveal-on-scroll"
                style={`transition-delay: ${index * 0.1}s;`}
              >
                <a href={`/projects/${project.id}`} class="card-image">
                  {typeof imgUrl === 'string' ? (
                    <img
                      src={imgUrl}
                      alt={project.data.imageAlt || project.data.title}
                      width="400"
                      height="300"
                      loading="lazy"
                      style="width: 100%; height: 100%; object-fit: cover;"
                      onerror={`this.onerror=null;this.src='${FALLBACK_IMAGE}';`}
                    />
                  ) : (
                    <Image 
                      src={imgUrl} 
                      alt={project.data.imageAlt || project.data.title} 
                      width={400}
                      height={300}
                      format="webp"
                      quality="mid"
                    />
                  )}
                </a>
                  <div class="card-content">
                  <h3 class="project-title">{project.data.title}</h3>
                  <div class="card-meta" role="button" aria-expanded="false" tabindex="0">
                    <span class="project-location">{project.data.location}</span>
                    <div class="description-toggle-icon">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m6 9 6 6 6-6"/>
                      </svg>
                    </div>
                  </div>
                  <div class="description-wrapper">
                    <div class="description-content">
                      {project.data.description && <p>{project.data.description}</p>}
                      <a href={`/projects/${project.id}`} class="card-link-text">Explore Project</a>
                    </div>
                  </div>
                </div>
              </div>
            );
          })}
        </div>

        <div class="index-cta-wrap reveal-on-scroll">
            <a href="/contact" class="index-cta-btn">Start your project</a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  function setupReveal() {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('reveal-visible');
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('.reveal-on-scroll').forEach(el => {
      observer.observe(el);
    });
  }

  function setupToggles() {
    const cards = document.querySelectorAll('.project-card');
    cards.forEach(card => {
      const meta = card.querySelector('.card-meta');
      
      if (meta) {
        meta.addEventListener('click', (e) => {
          const isOpen = card.classList.contains('is-open');
          
          if (!isOpen) {
            card.classList.add('is-open');
            meta.setAttribute('aria-expanded', 'true');
          } else {
            card.classList.remove('is-open');
            meta.setAttribute('aria-expanded', 'false');
          }
        });

        // Accessibility for keyboard
        meta.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            meta.click();
          }
        });
      }
    });
  }

  setupReveal();
  setupToggles();
  
  document.addEventListener('astro:after-swap', () => {
    setupReveal();
    setupToggles();
  });
</script>
