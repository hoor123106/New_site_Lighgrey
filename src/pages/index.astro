---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Hero2Section from '../components/Hero2Section.astro';
import CTASection from '../components/CTASection.astro';
import LastSection from '../components/LastSection.astro';
import '../styles/global.css';

const title = "Steelcraft | Industrial Kitchen & Bakery Solutions";
const description = "Premium stainless steel solutions for commercial kitchens, industrial bakeries, and high-end residences with over 16 years of expertise.";
---

<Layout title={title} description={description} fullWidth={true}>
  <main class="home-main">
    <Hero />
    <Hero2Section />
    <CTASection />
    <LastSection />
  </main>
</Layout>

<style>
  .home-main {
    overflow-x: hidden;
  }
</style>
