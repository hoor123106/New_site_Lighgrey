---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import '../../styles/blog-index.css';

const blogs = await getCollection('blog');
const sortedBlogs = blogs.sort((a, b) => {
  return new Date(b.data.date || 0).getTime() - new Date(a.data.date || 0).getTime();
});
const allImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/**/*.{jpeg,jpg,png,gif,webp}');
---

<Layout
  title="Our Blog | Steelcraft"
  description="Read our latest articles and updates."
>
  <main class="blog-index-page">
    <div class="container pb-40">
      <h1 class="page-title text-center">Our Blog</h1>
      <p class="page-subtitle text-center">Insights, news, and updates</p>

      <div class="blog-grid">
        {sortedBlogs.map((blog) => {
          const imagePath = blog.data.imageFeatured?.replace('../../assets', '/src/assets');
          const filename = imagePath?.split('/').pop();
          const imageKey = Object.keys(allImages).find(key => key === imagePath || key.endsWith(`/${filename}`));
          const imageSrc = imageKey ? allImages[imageKey] : null;
          
          return (
            <article class="blog-card reveal-on-scroll">
              <a href={`/blog/${blog.id.replace(/\.(md|mdx)$/, '')}`} class="blog-card-link">
                <div class="blog-card-image-wrapper">
                  {imageSrc ? (
                    <Image 
                      src={imageSrc()} 
                      alt={blog.data.imageAlt || blog.data.title}
                      width={600}
                      height={400}
                      class="blog-card-img"
                    />
                  ) : (
                    <div class="blog-card-placeholder">Blog Image</div>
                  )}
                </div>
                <div class="blog-card-content">
                  {blog.data.categories && (
                    <span class="blog-category">{blog.data.categories}</span>
                  )}
                  <h2 class="blog-title">{blog.data.title}</h2>
                  <div class="blog-meta">
                    {blog.data.date && <span class="blog-date">{blog.data.date}</span>}
                    {blog.data.authorName && <span class="blog-author">By {blog.data.authorName}</span>}
                  </div>
                  {blog.data.metaDescription && (
                    <p class="blog-excerpt">{blog.data.metaDescription}</p>
                  )}
                  <span class="read-more">Read Article &rarr;</span>
                </div>
              </a>
            </article>
          );
        })}
      </div>
    </div>
  </main>
</Layout>

<script>
  function setupReveal() {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('reveal-visible');
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('.reveal-on-scroll').forEach(el => {
      observer.observe(el);
    });
  }
  setupReveal();
  document.addEventListener('astro:after-swap', setupReveal);
</script>
