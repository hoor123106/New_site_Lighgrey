---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import '../../styles/blog-slug.css';

export async function getStaticPaths() {
  const blogs = await getCollection('blog');
  return blogs.map((blog) => ({
    params: { slug: blog.id.replace(/\.(md|mdx)$/, '') },
    props: { blog },
  }));
}

const { blog } = Astro.props;
const { Content } = await render(blog);
const d = blog.data;

// Dynamic import of images for the Image component
const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/**/*.{jpeg,jpg,png,gif,webp}'
);
---

<Layout title={d.metaTitle || d.title} description={d.metaDescription}>
  <article class="blog-post-page">
    <div class="container">
      <div class="back-link-wrapper reveal-on-scroll">
        <a href="/blog" class="back-link">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M19 12H5M12 19l-7-7 7-7" />
          </svg>
          Back to Blog
        </a>
      </div>

      <header class="blog-header reveal-on-scroll">
        {d.categories && <span class="blog-category">{d.categories}</span>}
        <h1 class="blog-title">{d.title}</h1>
        <div class="blog-meta">
          {d.date && <span class="blog-date">{d.date}</span>}
          {d.authorName && <span class="blog-author">By {d.authorName}</span>}
        </div>
      </header>

      {
        (() => {
          const imagePath = d.imageFeatured?.replace('../../assets', '/src/assets');
          const filename = imagePath?.split('/').pop();
          const imageKey = Object.keys(allImages).find(
            (key) => key === imagePath || key.endsWith(`/${filename}`)
          );
          const imageSrc = imageKey ? allImages[imageKey] : null;

          return imageSrc ? (
            <div class="blog-hero-image reveal-on-scroll">
              <Image
                src={imageSrc()}
                alt={d.imageAlt || d.title}
                width={1200}
                height={600}
                class="hero-img"
              />
            </div>
          ) : null;
        })()
      }

      <div class="blog-content mdx-body mdx-black-and-white">
        <Content />
      </div>
    </div>
  </article>
</Layout>

<script>
  function setupReveal() {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('reveal-visible');
          }
        });
      },
      { threshold: 0.1 }
    );

    document.querySelectorAll('.reveal-on-scroll').forEach((el) => {
      observer.observe(el);
    });
  }

  setupReveal();
  // Re-run setup after view transitions
  document.addEventListener('astro:after-swap', setupReveal);
</script>